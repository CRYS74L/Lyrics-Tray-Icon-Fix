<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Lyrics Tray Icon Fix</title>
<HTA:APPLICATION ID="DialogApp" SCROLL="no" INNERBORDER="no" CONTEXTMENU="no" SELECTION="yes" />
<style>
html, body { margin: 0; padding: 0; background: #F0F0F0; font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif; color: #000000; }
#wrap { padding: 16px 18px; }
#message { min-height: 90px; max-height: 220px; overflow: auto; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
#buttons { margin-top: 14px; text-align: right; }
button { min-width: 80px; height: 28px; margin-left: 8px; border: 1px solid #B0B0B0; background: #F5F5F5; font-size: 12px; cursor: pointer; }
button.copy { min-width: 90px; }
</style>
<script language="VBScript">
On Error Resume Next
Dim fso, htaPath, msgPath, stream, text
Set fso = CreateObject("Scripting.FileSystemObject")
htaPath = Unescape(Replace(Replace(window.location.href, "file:///", ""), "/", "\"))
msgPath = fso.GetParentFolderName(htaPath) & "\popup-message.txt"
Set stream = CreateObject("ADODB.Stream")
stream.Type = 2
stream.Charset = "unicode"
stream.Open
stream.LoadFromFile msgPath
text = stream.ReadText(-1)
stream.Close
If Err.Number <> 0 Then
  text = "无法读取提示内容。"
  Err.Clear
End If
document.getElementById("message").innerText = text
</script>
<script language="JavaScript">
function copyMessage() {
  var text = document.getElementById("message").innerText;
  window.clipboardData.setData("Text", text);
}
</script>
</head>
<body onload="window.resizeTo(520,320); window.moveTo((screen.width-520)/2,(screen.height-320)/2)">
<div id="wrap">
  <div id="message"></div>
  <div id="buttons">
    <button class="copy" onclick="copyMessage()">复制</button>
    <button onclick="window.close()">确定</button>
  </div>
</div>
</body>
</html>
